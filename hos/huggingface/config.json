{
  "architectures": ["GPT2LMHeadModel"],
  "model_type": "gpt2",
  "vocab_size": 1024,
  "n_positions": 512,
  "n_ctx": 512,
  "n_embd": 768,
  "n_layer": 12,
  "n_head": 12,
  "activation_function": "gelu_new",
  "resid_pdrop": 0.1,
  "embd_pdrop": 0.1,
  "attn_pdrop": 0.1,
  "layer_norm_epsilon": 0.00001,
  "initializer_range": 0.02,
  "scale_attn_weights": true,
  "use_cache": true,
  "bos_token_id": 0,
  "eos_token_id": 1,
  "tie_word_embeddings": true
}
