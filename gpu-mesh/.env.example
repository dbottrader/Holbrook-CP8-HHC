# Copy to .env before exposing a coordinator. The compose default token is for local use only.
GPU_MESH_ADMIN_TOKEN=replace-with-a-long-random-string
GPU_MESH_PUBLIC_BASE_URL=https://gpu.example.com
# GPU_MESH_DATABASE_URL=postgresql+psycopg://gpumesh:gpumesh@postgres:5432/gpumesh
# GPU_MESH_TRUST_PROXY=1
# Fallback when no volunteer is online. Leave unset to keep the mesh volunteer-only.
# GPU_MESH_GROQ_API_KEY=
# GPU_MESH_GROQ_MODEL=openai/gpt-oss-20b
# GPU_MESH_GROQ_VERIFY_MODEL=llama-3.1-8b-instant
# GPU_MESH_LEDGER_BACKEND=simulated
# Optional Cloudflare Workers AI free-tier fallback when no volunteer is online.
# Use a free allow-listed model only. Paid models such as kimi-k2.6 are rejected.
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID are also honored if set.
# GPU_MESH_CLOUDFLARE_API_TOKEN=
# GPU_MESH_CLOUDFLARE_ACCOUNT_ID=
# GPU_MESH_CLOUDFLARE_SECRETS_DIR=
# GPU_MESH_CLOUDFLARE_MODEL=@cf/meta/llama-3.2-1b-instruct
# GPU_MESH_CLOUDFLARE_VERIFY_MODEL=@cf/ibm-granite/granite-4.0-h-micro
# GPU_MESH_CLOUDFLARE_DAILY_NEURON_CAP=2000
# GPU_MESH_CLOUDFLARE_DAILY_CALL_CAP=40
